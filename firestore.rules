rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 共通ヘルパー関数 =====

    // 配列の全要素が文字列かチェック（先頭要素のみ）
    function isStringArray(arr) {
      return arr is list && arr.size() > 0 && arr[0] is string;
    }

    // 非空文字列チェック
    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    // 0 以上の数値チェック
    function isNonNegativeNumber(value) {
      return value is number && value >= 0;
    }

    // 0 より大きい数値チェック
    function isPositiveNumber(value) {
      return value is number && value > 0;
    }

    // 0〜100 の率チェック
    function isRate0to100(value) {
      return value is number && value >= 0 && value <= 100;
    }

    // 認証済みユーザーかチェック
    function isAuthenticated() {
      return request.auth != null;
    }

    // 自分のデータかチェック（パスの {userId} と uid を比較）
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // resource.data.userId が本人か
    function isUserOwnedResource() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // request.resource.data.userId が本人か
    function isUserOwnedRequest() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // resource.data.createdBy が本人か
    function isCreatedByUserResource() {
      return isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }

    // request.resource.data.createdBy が本人か
    function isCreatedByUserRequest() {
      return isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
    }

    // 商品データのバリデーション
    function isValidProduct(product) {
      return product.keys().hasAll([
               'supplier',
               'name',
               'origin',
               'specification',
               'specificationUnit',
               'packageUnit',
               'store_cost',
               'price_excluding_tax',
               'total_delivery',
               'store_allocations'
             ]) &&
             isNonEmptyString(product.supplier) &&
             product.name is string &&
             product.origin is string &&
             product.specification is string &&
             isNonEmptyString(product.specificationUnit) &&
             isNonEmptyString(product.packageUnit) &&
             product.store_cost is number &&
             product.price_excluding_tax is number &&
             product.total_delivery is number &&
             product.store_allocations is list &&
             product.store_allocations.size() == 36;
    }

    // 注文データのバリデーション
    function isValidOrder(data) {
      return data.keys().hasAll([
               'delivery_date',
               'suppliers',
               'products',
               'buyer_name',
               'timestamp',
               'userId'
             ]) &&
             data.delivery_date is string &&
             data.suppliers is list &&
             data.suppliers.size() > 0 &&
             data.suppliers.size() <= 20 &&
             isStringArray(data.suppliers) &&
             data.products is list &&
             data.products.size() > 0 &&
             data.products.size() <= 50 &&
             data.buyer_name is string &&
             data.userId is string &&
             data.userId == request.auth.uid;
    }

    // 全商品の帳合先が suppliers リストに含まれているかチェック（代表として先頭のみ）
    function allProductSuppliersValid(suppliers, products) {
      return products.size() == 0 ||
             products[0].supplier in suppliers;
      // Note: Firestore ルールでは配列の全要素をループできないため、
      // 完全なバリデーションはクライアント側で行う必要があります
    }

    // ===== コレクションごとのルール =====

    // ユーザープロファイル
    match /user_profiles/{userId} {
      // 読み取り: 本人のみ
      allow read: if isOwner(userId);
      // 作成: 認証済みで、自分のUIDのドキュメントのみ
      allow create: if isOwner(userId);
      // 更新: 本人のみ
      allow update: if isOwner(userId);
      // 削除: 禁止
      allow delete: if false;
    }

    // 帳合先マスター
    match /suppliers/{supplierId} {
      // 読み取り: 作成者のみ
      allow read, update, delete: if isCreatedByUserResource();
      // 作成: 認証済みユーザーのみ
      allow create: if isCreatedByUserRequest();
    }

    // 商品マスター
    match /products/{productId} {
      // 読み取り: 作成者のみ
      allow read, update, delete: if isCreatedByUserResource();
      // 作成: 認証済みユーザーのみ
      allow create: if isCreatedByUserRequest();
    }

    // 配分データ（注文）
    match /haibun_orders/{orderId} {
      // 読み取り: 作成者のみ
      allow read: if isUserOwnedResource();
      // 作成: 認証済みユーザーのみ + データバリデーション
      allow create: if isUserOwnedRequest() &&
                       isValidOrder(request.resource.data) &&
                       allProductSuppliersValid(
                         request.resource.data.suppliers,
                         request.resource.data.products
                       );
      // 更新: 作成者のみ + データバリデーション
      allow update: if isUserOwnedResource() &&
                       isValidOrder(request.resource.data) &&
                       allProductSuppliersValid(
                         request.resource.data.suppliers,
                         request.resource.data.products
                       );
      // 削除: 作成者のみ
      allow delete: if isUserOwnedResource();
    }

    // 入力履歴（オートコンプリート用）
    match /autocomplete_history/{docId} {
      // 読み取り: 認証済みユーザーのみ（自分の履歴のみ）
      allow read, update, delete: if isUserOwnedResource();
      // 作成: 認証済みユーザーのみ
      allow create: if isUserOwnedRequest();
    }

    // 帳合先プリセット
    match /supplier_presets/{presetId} {
      // 読み取り: 認証済みユーザーのみ（自分のプリセットのみ）
      allow read, update, delete: if isUserOwnedResource();

      // 作成: 認証済みユーザーのみ + 必須フィールドチェック
      allow create: if isUserOwnedRequest() &&
                       request.resource.data.keys().hasAll([
                         'supplier',
                         'userId'
                       ]) &&
                       isNonEmptyString(request.resource.data.supplier) &&
                       (!request.resource.data.keys().hasAny(['centerFeeRate']) ||
                        isRate0to100(request.resource.data.centerFeeRate));

      // 更新: 自分のプリセットのみ + フィールドバリデーション
      allow update: if isUserOwnedResource() &&
                       (!request.resource.data.keys().hasAny(['centerFeeRate']) ||
                        isRate0to100(request.resource.data.centerFeeRate));
    }

    // メールアドレス帳
    match /email_addresses/{addressId} {
      // 読み取り: 認証済みユーザーのみ（自分のアドレス帳のみ）
      allow read, update, delete: if isUserOwnedResource();

      // 作成: 認証済みユーザーのみ + 必須フィールドチェック
      allow create: if isUserOwnedRequest() &&
                       request.resource.data.keys().hasAll([
                         'name',
                         'email',
                         'userId'
                       ]) &&
                       isNonEmptyString(request.resource.data.name) &&
                       isNonEmptyString(request.resource.data.email);
    }

    // 商品履歴
    match /product_history/{historyId} {
      // 読み取り: 認証済みユーザーのみ（自分の履歴のみ）
      allow read, update, delete: if isUserOwnedResource();

      // 作成: 認証済みユーザーのみ + 必須フィールドチェック
      allow create: if isUserOwnedRequest() &&
                       request.resource.data.keys().hasAll([
                         'supplier',
                         'name',
                         'origin',
                         'specification',
                         'specificationUnit',
                         'packageUnit',
                         'userId'
                       ]) &&
                       isNonEmptyString(request.resource.data.supplier) &&
                       isNonEmptyString(request.resource.data.name) &&
                       isNonEmptyString(request.resource.data.specificationUnit) &&
                       isNonEmptyString(request.resource.data.packageUnit);
    }

    // 価格履歴（ステップ3用）
    // Note: 重複防止ロジック（全く同じ値の場合は更新しない）はアプリケーション層で実装
    //       firestoreService.ts の savePricingHistory() を参照
    match /pricing_history/{historyId} {
      // 読み取り: 認証済みユーザーのみ（自分の履歴のみ）
      allow read, update, delete: if isUserOwnedResource();

      // 作成: 認証済みユーザーのみ + 必須フィールドチェック
      allow create: if isUserOwnedRequest() &&
                       request.resource.data.keys().hasAll([
                         'productName',
                         'specification',
                         'quantityPerPackage',
                         'specificationUnit',
                         'packageUnit',
                         'centerCost',
                         'storeCost',
                         'priceExcludingTax',
                         'userId'
                       ]) &&
                       isNonEmptyString(request.resource.data.productName) &&
                       request.resource.data.specification is string &&
                       isPositiveNumber(request.resource.data.quantityPerPackage) &&
                       isNonEmptyString(request.resource.data.specificationUnit) &&
                       isNonEmptyString(request.resource.data.packageUnit) &&
                       isNonNegativeNumber(request.resource.data.centerCost) &&
                       isNonNegativeNumber(request.resource.data.storeCost) &&
                       isNonNegativeNumber(request.resource.data.priceExcludingTax);

      // 更新: 自分の履歴のみ + 価格フィールドのバリデーション
      // （仕様通り、これらのフィールドは常に送られてくる前提）
      allow update: if isUserOwnedResource() &&
                       isNonNegativeNumber(request.resource.data.centerCost) &&
                       isNonNegativeNumber(request.resource.data.storeCost) &&
                       isNonNegativeNumber(request.resource.data.priceExcludingTax);
    }

    // 店舗カテゴリー（ユーザーごとのサブコレクション）
    match /users/{userId}/store_categories/{categoryId} {
      // 読み取り: 本人のみ
      allow read: if isOwner(userId);
      // 作成: 本人のみ
      allow create: if isOwner(userId);
      // 更新: 本人のみ
      allow update: if isOwner(userId);
      // 削除: 本人のみ
      allow delete: if isOwner(userId);
    }

    // 店舗設定（販売構成比など）
    match /users/{userId}/store_settings/{storeCode} {
      // 読み取り: 本人のみ
      allow read: if isOwner(userId);
      // 作成: 本人のみ
      allow create: if isOwner(userId);
      // 更新: 本人のみ
      allow update: if isOwner(userId);
      // 削除: 本人のみ
      allow delete: if isOwner(userId);
    }

    // ユーザー設定（メール送信者名など）
    match /users/{userId}/user_settings/{settingId} {
      // 読み取り: 本人のみ
      allow read: if isOwner(userId);
      // 作成: 本人のみ
      allow create: if isOwner(userId);
      // 更新: 本人のみ
      allow update: if isOwner(userId);
      // 削除: 本人のみ
      allow delete: if isOwner(userId);
    }

    // 配分履歴バッチ（学習データ用）
    match /allocation_batches/{batchId} {
      // 読み取り: 認証済みユーザーのみ（自分のバッチのみ）
      allow read, update, delete: if isUserOwnedResource();

      // 作成: 認証済みユーザーのみ + 必須フィールドチェック
      allow create: if isUserOwnedRequest() &&
                       request.resource.data.keys().hasAll([
                         'userId',
                         'delivery_date',
                         'center_delivery_date',
                         'suppliers',
                         'product_count',
                         'total_quantity',
                         'buyer_name',
                         'book_name',
                         'sheet_name',
                         'created_at',
                         'updated_at'
                       ]) &&
                       request.resource.data.delivery_date is string &&
                       request.resource.data.delivery_date.size() == 10 &&
                       (request.resource.data.center_delivery_date == null ||
                        (request.resource.data.center_delivery_date is string &&
                         request.resource.data.center_delivery_date.size() == 10)) &&
                       request.resource.data.suppliers is list &&
                       request.resource.data.suppliers.size() > 0 &&
                       isPositiveNumber(request.resource.data.product_count) &&
                       isPositiveNumber(request.resource.data.total_quantity) &&
                       isNonEmptyString(request.resource.data.buyer_name) &&
                       isNonEmptyString(request.resource.data.book_name) &&
                       isNonEmptyString(request.resource.data.sheet_name);
    }

    // 配分履歴明細（学習データ用）
    match /allocation_details/{detailId} {
      // 読み取り: 認証済みユーザーのみ（自分の明細のみ）
      allow read, update, delete: if isUserOwnedResource();

      // 作成: 認証済みユーザーのみ + 必須フィールドチェック
      allow create: if isUserOwnedRequest() &&
                       request.resource.data.keys().hasAll([
                         'batch_id',
                         'userId',
                         'product_name',
                         'origin',
                         'specification',
                         'supplier',
                         'category_code',
                         'quantity_per_package',
                         'specification_unit',
                         'package_unit',
                         'center_cost',
                         'center_fee_rate',
                         'store_cost',
                         'price_excluding_tax',
                         'total_delivery',
                         'store_allocations',
                         'allocation_method',
                         'has_manual_adjustment',
                         'created_at'
                       ]) &&
                       isNonEmptyString(request.resource.data.batch_id) &&
                       isNonEmptyString(request.resource.data.product_name) &&
                       request.resource.data.origin is string &&
                       request.resource.data.specification is string &&
                       isNonEmptyString(request.resource.data.supplier) &&
                       (request.resource.data.category_code == null ||
                        request.resource.data.category_code is string) &&
                       (request.resource.data.quantity_per_package == null ||
                        isPositiveNumber(request.resource.data.quantity_per_package)) &&
                       isNonEmptyString(request.resource.data.specification_unit) &&
                       isNonEmptyString(request.resource.data.package_unit) &&
                       isNonNegativeNumber(request.resource.data.center_cost) &&
                       isRate0to100(request.resource.data.center_fee_rate) &&
                       isNonNegativeNumber(request.resource.data.store_cost) &&
                       isNonNegativeNumber(request.resource.data.price_excluding_tax) &&
                       isPositiveNumber(request.resource.data.total_delivery) &&
                       request.resource.data.store_allocations is list &&
                       request.resource.data.store_allocations.size() == 36 &&
                       request.resource.data.allocation_method is string &&
                       request.resource.data.has_manual_adjustment is bool;
    }

    // デフォルト: すべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
