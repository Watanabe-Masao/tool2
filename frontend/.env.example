# ============================================================
# Firebase Configuration (必須)
# ============================================================
# Firebaseプロジェクトの設定情報
# Firebase Console (https://console.firebase.google.com/) から取得してください
#
# 取得方法:
# 1. Firebase Console でプロジェクトを開く
# 2. プロジェクト設定 > 全般 > マイアプリ > ウェブアプリ
# 3. SDK の設定と構成 > 構成 をコピー
#
# このファイルをコピーして .env を作成し、実際の値を設定してください:
# cp .env.example .env

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ============================================================
# API Configuration (オプション)
# ============================================================
# バックエンドAPIのベースURL
# デフォルト: http://localhost:8000

VITE_API_BASE_URL=http://localhost:8000
